# Configuração do Supabase (Variáveis de Ambiente Públicas do Cliente)
# Nunca coloque a service_role key neste ficheiro nem no código fonte.
# Obtenha estes valores no painel do Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-supabase-anon-key

# Medição de Conversões & Google Search Console (Opcional)
VITE_GA_ID=
VITE_GTM_ID=
VITE_GSC_VERIFICATION=
